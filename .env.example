# ── RetroPost Konfiguration ─────────────────────────────────────────
# Trage alle Secrets selbst ein. Der Agent prüft nur, welche Werte leer sind (npm run doctor).

# Lokale Ports (UI/API nur auf 127.0.0.1, Gateway ist das einzige, was der Tunnel nach außen gibt)
PORT=4317
GATEWAY_PORT=4318

# Öffentliche HTTPS-Adresse deines Cloudflare Tunnels (zeigt auf http://localhost:GATEWAY_PORT)
# z. B. https://retropost.deinedomain.de  – nötig für Instagram/TikTok (Medien-Links + OAuth-Callback)
PUBLIC_BASE_URL=
# Token eines eigenen, benannten Cloudflare Tunnels (cloudflared tunnel token ...). Leer = Quick-Tunnel (nur zum Testen)
CLOUDFLARE_TUNNEL_TOKEN=

# YouTube (Google Cloud Projekt → OAuth-Client "Webanwendung")
# Redirect-URI: http://localhost:4317/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram (Meta-Developer-App, Produkt "Instagram API with Instagram Login")
# Redirect-URI: ${PUBLIC_BASE_URL}/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok (developers.tiktok.com → App mit Login Kit + Content Posting API)
# Redirect-URI: ${PUBLIC_BASE_URL}/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Erst auf 1 setzen, wenn deine App TikToks Audit bestanden hat (dann sind öffentliche API-Posts möglich)
TIKTOK_AUDITED=0

# Optional
CHROME_PATH=
RETROPOST_DATA_DIR=
# 1 = nichts wird wirklich gepostet (Simulation) – gut zum Ausprobieren
RETROPOST_DRY_RUN=0
